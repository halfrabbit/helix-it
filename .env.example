# Free address on the loc macvlan (192.168.1.0/24). Keep it out of the DHCP pool.
HELIX_IP=192.168.1.40

# Firewall appliance or the domain controller that resolves Active Directory names.
HELIX_DNS=192.168.1.1

HELIX_ADMIN_USER=admin
HELIX_ADMIN_PASSWORD=choose-a-password
HELIX_ORG=Helix IT

# Dataset paths on TrueNAS. Relative paths are next to this compose file.
HELIX_DATA_PATH=/mnt/tank/apps/helix-it/data
HELIX_PACKAGES_PATH=/mnt/tank/apps/helix-it/packages
